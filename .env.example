# ---------------------------------------------------------------------------
# Climb — copy this file to .env and adjust what you need. Every value below
# already has a working default, so `docker compose up -d` works as-is.
# ---------------------------------------------------------------------------

# Port the dashboard is published on (http://localhost:8080)
APP_PORT=8080

# --- database (runs in Docker, data lives in the climb-db volume) -----------
POSTGRES_USER=climb
POSTGRES_PASSWORD=climb
POSTGRES_DB=climb

# --- application ------------------------------------------------------------
# Fiat currency used for every valuation (usd / eur)
BASE_CURRENCY=usd
# How often wallets are re-synced automatically, 0 disables the scheduler
SYNC_INTERVAL_MINUTES=15
# Upper bound of movements pulled per wallet per sync
MAX_TX_PER_SYNC=200
# Price cache lifetime in seconds
PRICE_TTL_SECONDS=300
# Fill the database with a sample portfolio on first start (great for a demo)
DEMO_MODE=false

# --- optional API keys ------------------------------------------------------
# Everything works without keys on public endpoints; add them to raise limits.
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
